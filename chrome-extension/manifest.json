{
  "manifest_version": 3,
  "name": "Codeforces Un-definer",
  "version": "0.3.1",
  "description": "Toggle competitive programming macros and typedefs inline.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Codeforces Un-definer",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://codeforces.com/*",
        "*://*.codeforces.com/*",
        "*://codeforces.ru/*",
        "*://*.codeforces.ru/*",
        "*://atcoder.jp/*",
        "*://*.atcoder.jp/*",
        "*://qoj.ac/*",
        "*://*.qoj.ac/*",
        "*://oj.uz/*",
        "*://*.oj.uz/*",
        "*://codechef.com/*",
        "*://*.codechef.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
